%%{init: {
  "theme": "base",
  "look": "classic",
  "flowchart": {
    "useMaxWidth": false,
    "htmlLabels": false,
    "curve": "linear",
    "nodeSpacing": 34,
    "rankSpacing": 48
  },
  "themeVariables": {
    "fontFamily": "Helvetica, Arial, sans-serif",
    "fontSize": "15px",
    "background": "#F8FAFC",
    "primaryTextColor": "#0F172A",
    "lineColor": "#64748B",
    "clusterBkg": "#FFFFFF",
    "clusterBorder": "#CBD5E1"
  }
}}%%
flowchart TB
    user([Użytkownik]):::actor

    subgraph CLIENT["KLIENT — Next.js 16 + React 19 + Capacitor"]
        direction LR
        ui["Interfejs aplikacji<br/>Web / iOS"]:::ui
        localDb[("Lokalna baza SQLite<br/>encje + kolejka OUTBOX")]:::storage
        localFiles["Lokalny magazyn plików<br/>media + ikony"]:::files
        worker["SyncService<br/>po logowaniu + co 30 s"]:::sync

        ui -->|"1. zapis local-first"| localDb
        ui --> localFiles
        localDb --> worker
    end

    subgraph NETWORK["GRANICA SIECIOWA — HTTP"]
        direction LR
        json["JSON<br/>logowanie • PUSH zmian ≤ 20 • PULL pełnego stanu"]:::api
        binaries["multipart + pliki statyczne<br/>wysyłanie i pobieranie mediów"]:::files
    end

    subgraph SERVER["CENTRALNY SERWER — FastAPI + SQLAlchemy async"]
        direction LR
        api["FastAPI<br/>routery + schematy Pydantic"]:::server
        engine["SyncService + resolvery<br/>walidacja • wersje • konflikty • transakcja"]:::sync
        postgres[("PostgreSQL 15<br/>kanoniczne metadane + tombstones")]:::storage
        mediaStorage["media_storage<br/>pliki użytkowników"]:::files

        api --> engine --> postgres
        api --> mediaStorage
    end

    user --> CLIENT
    CLIENT -->|"2–3. PUSH: metadane + pliki"| NETWORK
    NETWORK -->|"HTTP: JSON + multipart"| SERVER
    SERVER -.->|"4–5. PULL: pełny stan + brakujące pliki"| NETWORK
    NETWORK -.-> CLIENT

    classDef actor fill:#FFFFFF,stroke:#475569,color:#0F172A,stroke-width:1.5px;
    classDef ui fill:#DBEAFE,stroke:#60A5FA,color:#0F172A,stroke-width:1.5px;
    classDef sync fill:#FEF3C7,stroke:#F59E0B,color:#0F172A,stroke-width:1.5px;
    classDef api fill:#F3E8FF,stroke:#C084FC,color:#0F172A,stroke-width:1.5px;
    classDef server fill:#EDE9FE,stroke:#A78BFA,color:#0F172A,stroke-width:1.5px;
    classDef storage fill:#DCFCE7,stroke:#22C55E,color:#0F172A,stroke-width:1.5px;
    classDef files fill:#FFEDD5,stroke:#FB923C,color:#0F172A,stroke-width:1.5px;

    style CLIENT fill:#EFF6FF,stroke:#93C5FD,stroke-width:2px,color:#0F172A
    style NETWORK fill:#F1F5F9,stroke:#CBD5E1,stroke-width:2px,color:#0F172A
    style SERVER fill:#F5F3FF,stroke:#C4B5FD,stroke-width:2px,color:#0F172A
